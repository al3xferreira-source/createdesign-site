---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-info">
        <img
          class="brand-logo"
          src="/create-logo.png"
          alt="Create — Comunicação e Imagem"
        />
        <p>Comunicação & Imagem — Criamos marcas que comunicam.</p>
      </div>
      <div class="footer-social">
        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a href="https://behance.net" target="_blank" rel="noopener" aria-label="Behance">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 5h6.5a3.5 3.5 0 0 1 0 7H2z"/>
            <path d="M2 12h7a3.5 3.5 0 0 1 0 7H2z"/>
            <path d="M15 8h6"/>
            <path d="M14 14h8a4 4 0 0 0-8 0v1a4 4 0 0 0 8 3"/>
          </svg>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      © {year} Create — Comunicação e Imagem. Todos os direitos reservados.
    </div>
  </div>
</footer>
