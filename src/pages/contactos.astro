---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contactos — Create">
  <section class="section contact-section">
    <div class="container contact-container">
      <div class="section-header">
        <span class="eyebrow">Contactos</span>
        <h2>Vamos conversar</h2>
        <p>
          Conte-nos sobre o seu projeto. Respondemos a todos os pedidos em
          menos de 48 horas.
        </p>
      </div>

      <div class="contact-grid">
        <!-- Info -->
        <div class="contact-info">
          <div class="contact-item">
            <div class="contact-item-icon">✉️</div>
            <div>
              <h4>Email</h4>
              <a href="mailto:team@createdesign.pt">team@createdesign.pt</a>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">📞</div>
            <div>
              <h4>Telefone</h4>
              <a href="tel:+351916807310">+351 916 807 310</a>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">📍</div>
            <div>
              <h4>Localização</h4>
              <p>Portugal — Trabalhamos com clientes em todo o país</p>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">🕐</div>
            <div>
              <h4>Horário</h4>
              <p>Segunda a Sexta — 09:00 às 18:00</p>
            </div>
          </div>
        </div>

        <!-- Form -->
        <form class="contact-form" id="contactForm">
          <div class="form-group">
            <label for="name">Nome *</label>
            <input type="text" id="name" name="name" required placeholder="O seu nome" />
          </div>
          <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required placeholder="o.seu@email.pt" />
          </div>
          <div class="form-group">
            <label for="service">Serviço de interesse</label>
            <select id="service" name="service">
              <option value="">Selecione um serviço</option>
              <option value="design">Design Gráfico</option>
              <option value="branding">Branding & Identidade</option>
              <option value="web">Web Design & Desenvolvimento</option>
              <option value="social">Gestão de Redes Sociais</option>
              <option value="video">Vídeo & Motion</option>
              <option value="marketing">Marketing Digital</option>
              <option value="outro">Outro</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Mensagem *</label>
            <textarea id="message" name="message" required placeholder="Descreva o seu projeto..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">
            Enviar Mensagem →
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-section {
    padding: 120px 0;
  }

  .contact-container {
    max-width: 1280px;
  }

  .contact-section :global(.section-header) {
    margin-bottom: 72px;
  }

  .contact-section :global(.section-header h2) {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
  }

  .contact-section :global(.section-header p) {
    max-width: 680px;
    font-size: 1.2rem;
  }

  .contact-grid {
    grid-template-columns: minmax(340px, 0.8fr) minmax(520px, 1.2fr);
    gap: 64px;
  }

  .contact-info {
    gap: 36px;
  }

  .contact-item {
    gap: 20px;
  }

  .contact-item-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    font-size: 1.5rem;
  }

  .contact-item h4 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }

  .contact-item p,
  .contact-item a {
    font-size: 1.05rem;
  }

  .contact-form {
    padding: 44px;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-group label {
    font-size: 1rem;
    margin-bottom: 10px;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    min-height: 52px;
    padding: 14px 18px;
    font-size: 1.05rem;
  }

  .form-group textarea {
    min-height: 180px;
  }

  .contact-form :global(.btn) {
    min-height: 56px;
    font-size: 1.05rem;
  }

  @media (max-width: 900px) {
    .contact-section {
      padding: 80px 0;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .contact-info {
      gap: 28px;
    }
  }

  @media (max-width: 640px) {
    .contact-section {
      padding: 64px 0;
    }

    .contact-section :global(.section-header) {
      margin-bottom: 48px;
    }

    .contact-form {
      padding: 24px 20px;
    }

    .contact-item-icon {
      width: 48px;
      height: 48px;
    }
  }
</style>

<script>
  const form = document.getElementById("contactForm");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get("name");
    const email = data.get("email");
    const service = data.get("service");
    const message = data.get("message");

    const subject = encodeURIComponent(
      `Novo contacto — ${name} (${service || "geral"})`
    );
    const body = encodeURIComponent(
      `Nome: ${name}\nEmail: ${email}\nServiço: ${service || "N/A"}\n\nMensagem:\n${message}`
    );

    window.location.href = `mailto:team@createdesign.pt?subject=${subject}&body=${body}`;
  });
</script>
